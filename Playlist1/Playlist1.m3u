<div id="wb_JavaScript2" style="position:absolute;left:0px;top:0px;width:145px;height:35px;z-index:0;">
<div style="color:#FFFFFF;font-size:22px;font-family:Rubik;font-weight:normal;font-style:normal;text-align:center;text-decoration:none" id="basicdate"></div>
<script>
   var now = new Date();
   var days = new Array('Воскресенье','Понедельник','Вторник','Среда','Четверг','Пятница','Суббота');
   var date = ((now.getDate() < 10) ? "0" : "") + now.getDate();
   var months = new Array('01','02','03','04','05','06','07','08','09','10','11','12');
   var year = (now.getYear() < 1000) ? now.getYear() + 1900 : now.getYear();
   today = date + "." + months[now.getMonth()] + "." + year;
   var basicdate = document.getElementById('basicdate');
   basicdate.innerHTML = today;
</script>


